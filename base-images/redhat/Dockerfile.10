# syntax=docker/dockerfile:1
# RedHat UBI 10 (ubi-minimal) — CIS-hardened base image.
# Hardened to CIS Docker Benchmark v1.7.0 (section 4) + CIS Docker-Image checks.
# Base pinned by tag AND digest (CIS 4.2 / 4.5 — trusted, immutable base).
FROM registry.access.redhat.com/ubi10/ubi-minimal:latest@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e

# Static metadata only: build-specific labels (created, revision, version,
# source) are applied by docker-bake.hcl so they never invalidate the cache.
LABEL maintainer="Golden Image Build System" \
      org.opencontainers.image.vendor="Golden Image Build System" \
      org.opencontainers.image.title="RedHat UBI 10 CIS-Hardened Base" \
      org.opencontainers.image.description="UBI 10 minimal base hardened to CIS Docker Benchmark v1.7.0" \
      org.opencontainers.image.licenses="MIT" \
      io.golden-image.cis.benchmark="CIS Docker Benchmark v1.7.0"

# Patch to latest, then harden. ca-certificates already ships in ubi-minimal,
# and shadow-utils is not installed: the hardening script writes the appuser
# entries directly, which keeps shadow-utils and its libsemanage/audit stack
# (size + CVE surface) out of the image. PATCH_EPOCH re-runs the update once
# per epoch so a cached layer cannot pin stale packages.
# ubi-minimal has no tini/dumb-init in its repos, so PID-1 reaping is left to
# the orchestrator; this is documented in docs/CIS-COMPLIANCE.md.
ARG PATCH_EPOCH
RUN --mount=type=bind,source=scripts/container,target=/opt/golden-scripts \
    echo "patch epoch: ${PATCH_EPOCH:-unset}" && \
    microdnf -y --nodocs --setopt=install_weak_deps=0 update && \
    microdnf clean all && \
    bash /opt/golden-scripts/harden-redhat.sh

WORKDIR /app

# Run as the non-root user created by the hardening script (CIS 4.1).
USER appuser

# CIS 4.6 / CIS-DI-0006 — define a HEALTHCHECK.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -r /etc/os-release || exit 1

CMD ["/bin/bash"]
