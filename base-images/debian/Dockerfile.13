# syntax=docker/dockerfile:1
# Debian 13 (Trixie) LTS — CIS-hardened base image.
# Hardened to CIS Docker Benchmark v1.7.0 (section 4) + CIS Docker-Image checks.
# Base pinned by tag AND digest (CIS 4.2 / 4.5 — trusted, immutable base).
FROM debian:13-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

# Static metadata only: build-specific labels (created, revision, version,
# source) are applied by docker-bake.hcl so they never invalidate the cache.
LABEL maintainer="Golden Image Build System" \
      org.opencontainers.image.vendor="Golden Image Build System" \
      org.opencontainers.image.title="Debian 13 (Trixie) CIS-Hardened Base" \
      org.opencontainers.image.description="Debian 13 base hardened to CIS Docker Benchmark v1.7.0" \
      org.opencontainers.image.licenses="MIT" \
      io.golden-image.cis.benchmark="CIS Docker Benchmark v1.7.0"

ENV DEBIAN_FRONTEND=noninteractive

# Patch to latest, install only init + CA certs, drop packages that have no job
# in a container (login, mount: console login and mount(8)), then harden.
# Single layer; update+install combined (CIS 4.7). PATCH_EPOCH re-runs the
# upgrade once per epoch so a cached layer cannot pin stale packages.
ARG PATCH_EPOCH
RUN --mount=type=bind,source=scripts/container,target=/opt/golden-scripts \
    echo "patch epoch: ${PATCH_EPOCH:-unset}" && \
    apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates tini && \
    apt-get purge -y --allow-remove-essential login mount && \
    apt-get autoremove -y --purge && \
    bash /opt/golden-scripts/harden-debian.sh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Run as the non-root user created by the hardening script (CIS 4.1).
USER appuser

# CIS 4.6 / CIS-DI-0006 — define a HEALTHCHECK.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -r /etc/os-release || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
