# syntax=docker/dockerfile:1
# Alpine Linux 3.23 LTS — CIS-hardened base image.
# Hardened to CIS Docker Benchmark v1.7.0 (section 4) + CIS Docker-Image checks.
# Base pinned by tag AND digest (CIS 4.2 / 4.5 — trusted, immutable base).
FROM alpine:3.23@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63

# Static metadata only: build-specific labels (created, revision, version,
# source) are applied by docker-bake.hcl so they never invalidate the cache.
LABEL maintainer="Golden Image Build System" \
      org.opencontainers.image.vendor="Golden Image Build System" \
      org.opencontainers.image.title="Alpine Linux 3.23 CIS-Hardened Base" \
      org.opencontainers.image.description="Alpine 3.23 base hardened to CIS Docker Benchmark v1.7.0" \
      org.opencontainers.image.licenses="MIT" \
      io.golden-image.cis.benchmark="CIS Docker Benchmark v1.7.0"

# PATCH_EPOCH (the UTC date in CI) is the only build input this layer sees: it
# re-runs the upgrade once per epoch, so a cached layer cannot pin stale
# packages. The hardening script is bind-mounted, never copied into a layer.
ARG PATCH_EPOCH
RUN --mount=type=bind,source=scripts/container,target=/opt/golden-scripts \
    echo "patch epoch: ${PATCH_EPOCH:-unset}" && \
    apk upgrade --no-cache && \
    apk add --no-cache ca-certificates tini && \
    sh /opt/golden-scripts/harden-alpine.sh

WORKDIR /app
USER appuser

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD test -r /etc/os-release || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/bin/sh"]
